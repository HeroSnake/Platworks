{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"required": ["appId", "name", "totalAchievements", "achievements"],
	"properties": {
		"appId": { "type": "integer" },
		"name": { "type": "string" },
		"totalAchievements": { "type": "integer" },
		"mapUrl": { "type": "string", "format": "uri" },
		"checklist": {
			"description": "Optional completion checklist, rendered as a second tab on the game page. Omit it for games with no authored checklist.",
			"type": "array",
			"items": {
				"type": "object",
				"required": ["id", "label", "title", "steps"],
				"properties": {
					"id": { "type": "string" },
					"label": { "type": "string" },
					"title": { "type": "string" },
					"steps": {
						"type": "array",
						"minItems": 1,
						"items": {
							"type": "object",
							"required": ["id", "text"],
							"properties": {
								"id": { "type": "string" },
								"text": { "type": "string" },
								"trophies": { "type": "array", "items": { "type": "string" } },
								"missable": { "type": "boolean" },
								"deadline": { "type": "string" }
							}
						}
					}
				}
			}
		},
		"achievements": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["id", "name", "description", "types", "difficulty", "guide"],
				"properties": {
					"id": { "type": "string" },
					"name": { "type": "string" },
					"description": { "type": "string" },
					"iconUrl": { "type": "string", "format": "uri" },
					"types": {
						"description": "Non-exclusive traits. Empty array = an ordinary trophy; there is no 'standard' tag.",
						"type": "array",
						"uniqueItems": true,
						"items": {
							"type": "string",
							"enum": ["missable", "multiplayer", "cumulative", "secret"]
						}
					},
					"difficulty": {
						"type": "string",
						"enum": ["easy", "medium", "hard", "very-hard"]
					},
					"guide": {
						"type": "object",
						"required": ["steps"],
						"properties": {
							"steps": {
								"type": "array",
								"items": { "type": "string" },
								"minItems": 1
							},
							"videoUrl": { "type": "string", "format": "uri" },
							"sourceUrl": { "type": "string", "format": "uri" },
							"mapUrl": { "type": "string", "format": "uri" },
							"communityNotes": {
								"type": "array",
								"items": { "type": "string" }
							},
							"warnings": {
								"type": "array",
								"items": { "type": "string" }
							}
						}
					}
				}
			}
		}
	}
}
