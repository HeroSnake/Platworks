{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"required": ["appId", "name", "totalAchievements", "achievements"],
	"properties": {
		"appId": { "type": "integer" },
		"name": { "type": "string" },
		"totalAchievements": { "type": "integer" },
		"mapUrl": { "type": "string", "format": "uri" },
		"achievements": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["id", "name", "description", "types", "difficulty", "guide"],
				"properties": {
					"id": { "type": "string" },
					"name": { "type": "string" },
					"description": { "type": "string" },
					"iconUrl": { "type": "string", "format": "uri" },
					"types": {
						"description": "Non-exclusive traits. Empty array = an ordinary trophy; there is no 'standard' tag.",
						"type": "array",
						"uniqueItems": true,
						"items": {
							"type": "string",
							"enum": ["missable", "multiplayer", "cumulative", "secret"]
						}
					},
					"difficulty": {
						"type": "string",
						"enum": ["easy", "medium", "hard", "very-hard"]
					},
					"guide": {
						"type": "object",
						"required": ["steps"],
						"properties": {
							"steps": {
								"type": "array",
								"items": { "type": "string" },
								"minItems": 1
							},
							"videoUrl": { "type": "string", "format": "uri" },
							"sourceUrl": { "type": "string", "format": "uri" },
							"mapUrl": { "type": "string", "format": "uri" },
							"communityNotes": {
								"type": "array",
								"items": { "type": "string" }
							},
							"warnings": {
								"type": "array",
								"items": { "type": "string" }
							}
						}
					}
				}
			}
		}
	}
}
